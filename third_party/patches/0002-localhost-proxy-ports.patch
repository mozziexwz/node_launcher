+PROXYBRIDGE_API void ProxyBridge_SetLocalhostProxyPorts(const UINT16 *ports, UINT32 count)
+{
+    for (int i = 0; i < 2048; i++)
+        InterlockedExchange(&g_localhost_proxy_ports[i], 0);
+    for (UINT32 i = 0; ports != NULL && i < count; i++)
+        InterlockedOr(&g_localhost_proxy_ports[ports[i] >> 5], (LONG)(1UL << (ports[i] & 31)));
+    log_message("Localhost proxy ports: %u set", count);
+}
