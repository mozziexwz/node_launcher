@@ -72,6 +72,17 @@ volatile LONG port_direct_bitmap[2048]  = {0};  // 8 KB
 
 UINT16 g_local_relay_port = LOCAL_PROXY_PORT;
 BOOL g_localhost_via_proxy = FALSE;  // default disabled for security - most proxy server block localhost for ssrf and also many app might not work if localhost trafic goes to remote server if proxy server is on diffrent machine
+
+// MSBOOST patch P4: loopback TCP ports that rules may still proxy while
+// localhost routing is direct. The launcher lists the ports of the Windows
+// system proxy (v2rayN, Clash and the like) so that a game's requests to that
+// proxy reach the launcher instead. One bit per port, read lock-free.
+volatile LONG g_localhost_proxy_ports[2048] = {0};  // 8 KB
+
+static BOOL is_localhost_proxy_port(UINT16 port)
+{
+    return (g_localhost_proxy_ports[port >> 5] & (LONG)(1UL << (port & 31))) != 0;
+}
 LogCallback g_log_callback = NULL;
